---
/** The live flight view: a full-page map with stat cards beside it and a
 * detail panel that opens when a card is pressed.
 *
 * The whole thing is one component so the home page and a flight's own URL
 * show exactly the same view rather than drifting apart.
 *
 * The stat cards are rendered at build time from the track committed to
 * git, so the page has its numbers at first paint. The map waits one
 * wspr.live round trip behind a "locating" state and is then drawn once,
 * current -- drawing the bundled track first meant showing yesterday's
 * position and yanking it under the reader a second later. If wspr.live is
 * slow or down the bundled track draws anyway, honestly dated.
 *
 * Pressing a card selects a metric: the map's spots recolor by it and the
 * panel shows its chart and key numbers. The telemetry table and the
 * explanation live in their own panels, behind the Data and About buttons.
 *
 * More than one flight: `flights` is every flight on the site, in the
 * order the "Next flight" button walks them. On the home page (`mode`
 * "home") the flight is switched in place when the address says
 * `?feature=<flight_id>`: the built-in flight's cards are swapped for the
 * asked-for flight's, its committed track fetched from
 * /live/<flight_id>/track.json, and the live refresh proceeds from there.
 * A permalink page shows its own flight and the button links to the next
 * one's permalink.
 *
 * A closed flight (status "closed") is the same view with the clock
 * stopped: the committed track is final, so wspr.live is not asked and the
 * refresh timer never starts. The weather switch stays: it draws today's
 * weather either way, and the reader can decide whether that is useful.
 */
import { withBase } from "../lib/base";
import { siteConfig, UPSTREAM_REPO } from "../lib/config";
import { ghostsFor, trackFor } from "../lib/flights";
import { lastKnown } from "../lib/ghosts";
import { recordHolders, recordsHeldBy, summarize } from "../lib/records";
import { sidebarHtml } from "../lib/render";
import type { FlightMeta, GhostPoint, TrackPoint } from "../lib/types";

interface Props {
  flight: FlightMeta;
  track: TrackPoint[];
  /** Slots heard without telemetry; see lib/types.ts. */
  ghosts?: GhostPoint[];
  /** Every flight on the site, in "Next flight" order. Defaults to just
   * this one, which hides the button. */
  flights?: FlightMeta[];
  mode?: "home" | "permalink";
}
const { flight, track, ghosts = [], flights = [flight], mode = "permalink" } = Astro.props;
const ended = flight.status === "closed";
// The "Next flight" link, as built; the script re-aims it at the reader's
// current flight and carries their toggles along.
const after = flights[(flights.findIndex((f) => f.flight_id === flight.flight_id) + 1) % flights.length];
const nextHref = mode === "home"
  ? `?feature=${encodeURIComponent(after!.flight_id)}`
  : withBase(`/live/${encodeURIComponent(after!.flight_id)}/`);

// The records across every flight on the site (lib/records.ts), from the
// committed tracks: a summary each, which is what the page carries for the
// flights it is not showing. The script recomputes this flight's from the
// live track. With one flight there is nothing to compare, and no card.
const summaries = flights.length > 1
  ? flights.flatMap((f) => {
    const own = f.flight_id === flight.flight_id;
    const s = summarize(f, own ? track : trackFor(f), own ? ghosts : ghostsFor(f));
    return s ? [s] : [];
  })
  : [];
const records = summaries.length > 1
  ? { flights: summaries.length,
    held: recordsHeldBy(flight.flight_id, recordHolders(summaries)) }
  : undefined;
// Build-time render is metric; the script re-renders in the reader's
// remembered choice on load, which cannot be known here.
const sidebar = sidebarHtml(flight, track, "metric", null, { ghosts, records });
const last = lastKnown(track, ghosts);
// What the About panel needs to say about this instance: whose site, where
// its source lives, and where the project it is an instance of lives.
const site = { ...siteConfig, upstream: UPSTREAM_REPO };
---

<section
  class="fv fv-loading"
  data-flight={JSON.stringify(flight)}
  data-track={JSON.stringify(track)}
  data-ghosts={JSON.stringify(ghosts)}
  data-flights={JSON.stringify(flights)}
  data-summaries={JSON.stringify(summaries)}
  data-mode={mode}
  data-site={JSON.stringify(site)}
>
  <div class="fv-map-slot" role="region" aria-label="Flight map">
    <div class="fv-locating">
      <span class="fv-locating-ring"></span>Locating beacon&hellip;
    </div>
  </div>

  <header class="fv-top">
    <div class="fv-top-spacer"></div>
    <div class="fv-ctl-slot"></div>
    <div class="unit-toggle" role="group" aria-label="Units">
      <button type="button" data-units="metric" aria-pressed="true">Metric</button>
      <button type="button" data-units="imperial" aria-pressed="false">Imperial</button>
    </div>
  </header>

  <aside class="fv-side">
    <div class="fv-cards-slot" set:html={sidebar} />
    <div class="fv-side-foot">
      <div class="fv-side-links">
        <div class="fv-chips">
          <button type="button" class="fv-chip" id="overlay-toggle" hidden={flights.length < 2}
            aria-pressed="false" title="Draw the other flights on this map too">All flights</button>
          <a class="fv-chip" id="next-flight" href={nextHref} hidden={flights.length < 2}
            title={`${after!.callsign} ${after!.flight_id}`}>Next flight &rsaquo;</a>
          <button type="button" class="fv-chip" data-panel="data">Data</button>
          <button type="button" class="fv-chip" data-panel="about">About</button>
        </div>
        <p class="fv-updated" id="updated">
          {last
            ? `${ended ? "Flight ended · last" : "Newest"} position ${last.utc} UTC${
              last.coarse ? " (grid square only)" : ""}`
            : "No positions yet"}
        </p>
      </div>
    </div>
  </aside>
  {/* Shown while the sidebar has more below the fold: the scrollbar is
    * hidden, so nothing else says the footer is down there. */}
  <div class="fv-side-more" id="side-more" hidden>
    <button type="button" aria-label="Scroll the sidebar down">
      <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
        <path d="M3 6l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>

  <div class="fv-panel" id="panel" hidden>
    <header class="fv-panel-head">
      <h2 class="fv-panel-title" id="panel-title"></h2>
      <div class="range-toggle" role="group" aria-label="Chart range" hidden>
        <button type="button" data-range="all" aria-pressed="true">Whole flight</button>
        <button type="button" data-range="ascent" aria-pressed="false">Ascent</button>
        <button type="button" data-range="recent" aria-pressed="false">Last 24 h</button>
      </div>
      <button type="button" class="fv-panel-close" id="panel-close" aria-label="Close panel">×</button>
    </header>
    <div class="fv-panel-body" id="panel-body"></div>
  </div>
</section>

<script>
  import type L from "leaflet";
  import { act, actOnce, startAnalytics } from "../lib/analytics";
  import { renderChart } from "../lib/charts";
  import { withBase } from "../lib/base";
  import { featureFromSearch, urlWithFeature } from "../lib/feature";
  import { renderMapInto } from "../lib/flightview";
  import { unwrapLons } from "../lib/basemap";
  import { heardBounds, lastKnown, unwrapNear } from "../lib/ghosts";
  import { addCornerControl } from "../lib/map";
  import type { GlobeHandle } from "../lib/globe";
  import {
    bearingDeg, compassPoint, fmtDuration, fmtInt, fmtLocalDay, fmtUtc, haversineKm,
    parseUtc, trackStats,
  } from "../lib/format";
  import { refreshTrack } from "../lib/livetrack";
  import { METRICS, isMetricKey, type MetricKey } from "../lib/metrics";
  import {
    overlaysFromSearch, resolveOverlays, urlWithOverlays, type OverlayChoice,
  } from "../lib/overlay";
  import {
    isRecordKey, recordHolders, recordPins, recordsHeldBy, summarize,
    type FlightSummary, type RecordKey,
  } from "../lib/records";
  import { recordsHtml, sidebarHtml, tableHtml, type ActiveCard } from "../lib/render";
  import {
    groundSpeedKt, hasSaturatedSpeed, resolveTrackSpeeds, speedText,
    SPEED_CEILING_KT,
  } from "../lib/speed";
  import { trackerDetailsHtml } from "../lib/trackerinfo";
  import type {
    FlightMeta, GhostPoint, MapMark, OverlayTrack, SiteConfig, TrackPoint,
  } from "../lib/types";
  import {
    panelFromSearch, urlWithPanel, type PanelKind,
  } from "../lib/panel";
  import { filterRange, RANGE_MIN_SPAN_MS, spanMs, type Range } from "../lib/range";
  import * as u from "../lib/units";
  import {
    convert, resolveUnits, saveUnits, unitLabels, urlWithUnits, type Units,
  } from "../lib/units";
  import {
    addWeatherControl, resolveWeather, saveWeather, urlWithWeather,
    type WeatherLayer,
  } from "../lib/weather";
  import {
    resolveView, saveView, urlWithView, type ViewMode,
  } from "../lib/viewmode";
  import {
    fetchForecast, forecastOrigin, HORIZON_HOURS, QUIET, resolveForecastMode,
    saveForecastMode, urlWithForecast, type Forecast, type ForecastMode,
  } from "../lib/forecast";

  const root = document.querySelector<HTMLElement>(".fv");
  if (root) {
    let meta = JSON.parse(root.dataset.flight!) as FlightMeta;
    const site = JSON.parse(root.dataset.site!) as SiteConfig & { upstream: string };
    let track = JSON.parse(root.dataset.track!) as TrackPoint[];
    let ghosts = JSON.parse(root.dataset.ghosts!) as GhostPoint[];
    const flights = JSON.parse(root.dataset.flights!) as FlightMeta[];
    // Every flight's record summary as built (lib/records.ts); this
    // flight's is recomputed from the live track, see summaries().
    const bundledSummaries = JSON.parse(root.dataset.summaries ?? "[]") as FlightSummary[];
    const mode = root.dataset.mode === "home" ? "home" : "permalink";
    // Before anything awaits, so an early tap still marks the page human.
    startAnalytics(() => meta.flight_id);
    /** A closed flight: the track is final and nothing is polled. */
    const ended = () => meta.status === "closed";
    // A `?u=i` link outranks the browser's remembered choice, so a shared
    // link shows the sender's units.
    let units: Units = resolveUnits(location.search, "metric");
    // Charts only. The map keeps the whole flight so the current position is
    // always on it, and the stats always describe now.
    let range: Range = "all";
    // The map is torn down and rebuilt on every refresh, so the weather
    // choice is held out here and handed back to each new control. A `?w=c`
    // link outranks the browser's memory, like `?u=` does, so a link sent
    // because of the weather arrives with the weather on.
    let weather: WeatherLayer = resolveWeather(location.search);
    // Flat map or globe. Either renderer draws from the same state; the
    // globe's renderer itself is lazy-loaded so the flat map never pays
    // maplibre's weight.
    let view: ViewMode = resolveView(location.search);
    // The predicted path ahead of the balloon (lib/forecast.ts): the
    // reader's choice, held out here like the weather's, and the
    // prediction itself, so a rebuilt map draws it without asking again.
    let forecastMode: ForecastMode = resolveForecastMode(location.search);
    let forecast: Forecast | null = null;
    // The newest full report is older than any wind the predictor holds, so
    // there is no line until the balloon is heard again; the button says so.
    let forecastQuiet = false;
    // Which panel is open, if any. A `?p=speed` link arrives with that
    // panel already open, so a link shows what its sender was looking at.
    let panel: PanelKind | null = panelFromSearch(location.search);
    // What the spots are colored by; the build-time render says altitude,
    // and a link that opens a metric's panel colors by it too, because
    // pressing that card is what a reader would have done to get there.
    let metric: MetricKey = panel && isMetricKey(panel) ? panel : "altitude";

    const mapSlot = root.querySelector<HTMLElement>(".fv-map-slot")!;
    const ctlSlot = root.querySelector<HTMLElement>(".fv-ctl-slot")!;
    const cardsSlot = root.querySelector<HTMLElement>(".fv-cards-slot")!;
    const panelEl = root.querySelector<HTMLElement>("#panel")!;
    const panelTitle = root.querySelector<HTMLElement>("#panel-title")!;
    const panelBody = root.querySelector<HTMLElement>("#panel-body")!;
    const rangeToggle = panelEl.querySelector<HTMLElement>(".range-toggle")!;
    const updatedEl = root.querySelector<HTMLElement>("#updated")!;
    const sideEl = root.querySelector<HTMLElement>(".fv-side")!;
    const sideMore = root.querySelector<HTMLElement>("#side-more")!;
    const nextLink = root.querySelector<HTMLAnchorElement>("#next-flight")!;
    const overlayBtn = root.querySelector<HTMLButtonElement>("#overlay-toggle")!;
    const REFRESH_MS = 2 * 60 * 1000;
    // How long a refresh waits for the forecast before drawing without it.
    const FORECAST_WAIT_MS = 2000;
    // Other flights on the same map (lib/overlay.ts): what the address
    // asked for, and the tracks fetched for it. Context only: they never
    // reach the cards or the panel.
    let overlayChoice: OverlayChoice | null = overlaysFromSearch(location.search);
    let overlays: OverlayTrack[] = [];
    // The records panel puts every other flight on the map while it is
    // open, so a record can be seen where it was set: their tracks, held
    // apart from the reader's own overlay choice, and the record the map
    // has been flown to, if any.
    let recordOverlays: OverlayTrack[] = [];
    let recordFocus: RecordKey | null = null;

    // ---------- which flight ----------

    /** The home page asked for another flight than the one it was built
     * around: take its cards over now, and its committed track as soon as
     * it arrives, so the refresh below starts from the same place a page
     * built for it would have. An id nobody has is ignored, so a link
     * with a typo still shows the flight rather than nothing. */
    let swapped = false;
    const wanted = mode === "home" ? featureFromSearch(location.search) : null;
    const chosen = wanted
      ? flights.find((f) => f.flight_id.toLowerCase() === wanted.toLowerCase())
      : undefined;
    if (chosen && chosen.flight_id !== meta.flight_id) {
      swapped = true;
      meta = chosen;
      track = [];
      ghosts = [];
      document.title = document.title.replace(/^[^—]*—/, `${meta.callsign} ${meta.flight_id} —`);
      cardsSlot.innerHTML = sidebarHtml(meta, track, units, null, {
        pending: true, records: recordsInfo(),
      });
      try {
        const at = (name: string) =>
          fetch(withBase(`/live/${encodeURIComponent(meta.flight_id)}/${name}`));
        const [trackResp, ghostResp] = await Promise.all([at("track.json"), at("ghosts.json")]);
        if (trackResp.ok) track = resolveTrackSpeeds(await trackResp.json() as TrackPoint[]);
        if (ghostResp.ok) ghosts = await ghostResp.json() as GhostPoint[];
      } catch {
        // The live refresh can still find the flight from launch; a closed
        // flight will say it has no positions, which is at least honest.
      }
    }

    /** The committed track and ghosts of another flight, for overlaying.
     * Fetched once per flight and shared: the overlay toggle and the
     * records panel then hold the same object, so a live overlay's refresh
     * reaches both. A fetch that fails leaves an empty overlay rather than
     * no overlay, so a live one can still be found from launch by the
     * refresh; it is not kept, so the next ask tries again. */
    const fetchedOverlays = new Map<string, Promise<OverlayTrack>>();
    function fetchOverlay(f: FlightMeta): Promise<OverlayTrack> {
      const have = fetchedOverlays.get(f.flight_id);
      if (have) return have;
      const at = (name: string) =>
        fetch(withBase(`/live/${encodeURIComponent(f.flight_id)}/${name}`));
      const p = (async (): Promise<OverlayTrack> => {
        try {
          const [t, g] = await Promise.all([at("track.json"), at("ghosts.json")]);
          return {
            meta: f,
            track: t.ok ? resolveTrackSpeeds(await t.json() as TrackPoint[]) : [],
            ghosts: g.ok ? await g.json() as GhostPoint[] : [],
          };
        } catch {
          fetchedOverlays.delete(f.flight_id);
          return { meta: f, track: [], ghosts: [] };
        }
      })();
      fetchedOverlays.set(f.flight_id, p);
      return p;
    }

    /** Every other flight's committed track, for the records panel. */
    async function loadRecordOverlays() {
      recordOverlays = await Promise.all(
        flights.filter((f) => f.flight_id !== meta.flight_id).map(fetchOverlay));
    }

    /** What the map draws under this flight: the reader's overlays, and
     * every other flight while the records panel is open. */
    function mapOverlays(): OverlayTrack[] {
      if (panel !== "records") return overlays;
      const have = new Set(overlays.map((o) => o.meta.flight_id));
      return [...overlays, ...recordOverlays.filter((o) => !have.has(o.meta.flight_id))];
    }

    /** Bring `overlays` in line with the choice: keep the ones already
     * loaded, fetch the rest, drop the ones no longer asked for -- and
     * never this flight itself, which the choice may name after a "Next
     * flight" press. */
    async function loadOverlays() {
      const ids = resolveOverlays(
        overlayChoice, meta.flight_id, flights.map((f) => f.flight_id));
      const have = new Map(overlays.map((o) => [o.meta.flight_id, o]));
      overlays = await Promise.all(ids.map((id) =>
        have.get(id) ?? fetchOverlay(flights.find((f) => f.flight_id === id)!)));
      paintOverlayToggle();
    }

    /** Ask wspr.live for the live overlays' newest reports, alongside the
     * refresh of the flight itself. Returns how many arrived. */
    async function refreshOverlays(): Promise<number> {
      const counts = await Promise.all(overlays.map(async (o) => {
        if (o.meta.status === "closed") return 0;
        const r = await refreshTrack(o.meta, o.track, o.ghosts);
        if (r.error) return 0;
        o.track = r.track;
        o.ghosts = r.ghosts;
        return r.added;
      }));
      return counts.reduce((a, b) => a + b, 0);
    }

    /** The chip: lit while other flights are on the map, named for the one
     * other flight when there is only one. */
    function paintOverlayToggle() {
      const others = flights.filter((f) => f.flight_id !== meta.flight_id);
      overlayBtn.hidden = others.length === 0;
      overlayBtn.setAttribute("aria-pressed", String(overlays.length > 0));
      overlayBtn.textContent = others.length === 1
        ? `Show ${others[0]!.flight_id}`
        : "All flights";
    }

    /** Aim the "Next flight" link at the flight after this one, carrying
     * the reader's toggles along: the home page switches in place, a
     * permalink page goes to the next permalink. */
    function paintNextLink() {
      if (flights.length < 2) return;
      const i = flights.findIndex((f) => f.flight_id === meta.flight_id);
      const next = flights[(i + 1) % flights.length]!;
      nextLink.href = flightHref(next.flight_id);
      nextLink.title = `${next.callsign} ${next.flight_id}`;
      nextLink.hidden = false;
    }

    /** The address of another flight with the reader's toggles along,
     * the overlays included, so switching keeps the comparison up. */
    function flightHref(flightId: string): string {
      return mode === "home"
        ? urlWithFeature(location.href, flightId)
        : withBase(`/live/${encodeURIComponent(flightId)}/`) + location.search + location.hash;
    }

    /** An overlaid flight was clicked on the map: make it the subject. */
    function openFlight(flightId: string) {
      act("Switch flight", { via: "map", to: flightId });
      location.assign(flightHref(flightId));
    }

    let map: L.Map | null = null;
    let globe: GlobeHandle | null = null;
    let globeMod: typeof import("../lib/globe") | null = null;
    // Once the reader has panned or zoomed, a refresh must not yank the view
    // back to the fitted bounds under their hands.
    let userMoved = false;
    // True until the map has been drawn for the first time, which happens
    // when the opening wspr.live check answers (or gives up); see the
    // component comment.
    let firstPaint = true;

    /** The globe renderer, loaded the first time it is asked for and kept.
     * Null when the chunk cannot be fetched, in which case the flat map is
     * the answer everywhere. */
    async function ensureGlobeMod() {
      if (!globeMod) {
        try {
          globeMod = await import("../lib/globe");
        } catch {
          /* offline or the chunk failed; the flat map still works */
        }
      }
      return globeMod;
    }
    // A `?v=g` arrival will need maplibre; fetch it during the opening
    // wspr.live wait instead of after it.
    if (view === "globe") void ensureGlobeMod();

    /** Flat map or globe. Rendered fresh with each map, like the weather
     * switch, so `view` is held out here and painted back in. */
    function buildViewToggle(): HTMLElement {
      const div = document.createElement("div");
      div.className = "weather-toggle view-toggle";
      div.setAttribute("role", "group");
      div.setAttribute("aria-label", "Map view");
      const options: { id: ViewMode; label: string; title: string }[] = [
        { id: "flat", label: "Flat",
          title: "The flat map, with every report's detail" },
        { id: "globe", label: "Globe",
          title: "The whole flight on a globe" },
      ];
      for (const o of options) {
        const b = document.createElement("button");
        b.type = "button";
        b.textContent = o.label;
        b.title = o.title;
        b.setAttribute("aria-pressed", String(view === o.id));
        b.addEventListener("click", () => void selectView(o.id));
        div.appendChild(b);
      }
      return div;
    }

    /** One button: the predicted path on or off. Built for a live flight
     * only; a closed flight's balloon is nowhere, so there is nothing to
     * predict and no button. */
    function buildForecastToggle(): HTMLElement {
      const div = document.createElement("div");
      div.className = "weather-toggle forecast-toggle";
      div.setAttribute("role", "group");
      div.setAttribute("aria-label", "Forecast");
      const b = document.createElement("button");
      b.type = "button";
      const fix = track.at(-1);
      const paused = forecastMode === "on" && forecastQuiet && fix;
      b.textContent = paused ? "Forecast paused" : "Forecast";
      b.title = paused
        ? `The forecast returns with the balloon's next full report. The ` +
          `last one, at ${fmtUtc(fix.utc)}, is older than the wind data ` +
          "the predictor holds, and a line started from it now would " +
          "leave out every hour of drift since."
        : `Where the wind takes it next: a ${HORIZON_HOURS / 24}-day float ` +
          "prediction from the newest report at its altitude, by SondeHub's " +
          "Tawhiri predictor on GFS winds. A guess, drawn as one.";
      b.setAttribute("aria-pressed", String(forecastMode === "on"));
      b.addEventListener("click", () =>
        void selectForecast(forecastMode === "on" ? "off" : "on"));
      div.appendChild(b);
      return div;
    }

    async function selectForecast(next: ForecastMode) {
      if (next === forecastMode) return;
      act("Forecast", { to: next, flight: meta.flight_id });
      forecastMode = next;
      saveForecastMode(next);
      pinInUrl(urlWithForecast(location.href, next));
      await syncForecast();
      // They asked for the line, not to be moved.
      drawMapAgain(true);
    }

    /** Bring `forecast` in line with the flight and the choice: predicted
     * from the newest report (the module caches it), or null. True when
     * what is held changed and the map has something new to draw.
     *
     * Only the newest call is allowed to land. A slow answer can arrive
     * after the reader has switched the line off, or after a later refresh
     * has already predicted from a newer fix; either way it is stale, and
     * writing it would put back a line that was taken away, or an older
     * prediction over a newer one. */
    let forecastGeneration = 0;
    async function syncForecast(): Promise<boolean> {
      const token = ++forecastGeneration;
      const origin = !ended() && forecastMode === "on"
        ? forecastOrigin(track, meta.float_m ?? null) : null;
      const next = origin ? await fetchForecast(origin) : null;
      if (token !== forecastGeneration) return false;
      const quiet = next === QUIET;
      const drawn = quiet ? null : next;
      const changed = drawn !== forecast || quiet !== forecastQuiet;
      forecast = drawn;
      forecastQuiet = quiet;
      return changed;
    }

    async function selectView(next: ViewMode) {
      if (next === view) return;
      if (next === "globe" && !(await ensureGlobeMod())) return;
      act("View", { to: next, flight: meta.flight_id });
      view = next;
      saveView(next);
      pinInUrl(urlWithView(location.href, next));
      // Each renderer opens on its own best framing: a mercator camera
      // carried onto the sphere (or back) lands nowhere useful.
      userMoved = false;
      drawMapAgain(false);
    }

    function drawMap(): void {
      // On desktop the map controls line up in the top bar beside the unit
      // toggle, leaving the right edge to the zoom control alone; on a
      // phone they sit along the bottom of the map.
      const wide = window.matchMedia("(min-width: 900px)").matches;
      const viewToggle = buildViewToggle();
      // Weather is today's weather, whatever the flight's status. The layers
      // are live products drawn under a track that may be two weeks old
      // whether the flight is still going or not, so a closed flight is no
      // worse a fit than a live one and the reader decides. Both renderers
      // share the choice, so switching views keeps the weather on.
      const weatherOpts = {
        initial: weather,
        onChange: (next: WeatherLayer) => {
          weather = next;
          act("Weather", { layer: next, flight: meta.flight_id });
          saveWeather(next);
          pinInUrl(urlWithWeather(location.href, next));
        },
      };
      const onInteract = () => {
        userMoved = true;
        actOnce("Map moved", { view, flight: meta.flight_id });
      };
      if (view === "globe" && globeMod) {
        try {
          globe = globeMod.renderGlobe(mapSlot, meta, track, {
            ghosts, overlays: mapOverlays(), marks: recordMarks(), forecast,
            onOverlayClick: openFlight,
            overlaid: wide && mapSlot.clientWidth >= 900,
            weather: { ...weatherOpts, ...(wide ? { into: ctlSlot } : {}) },
          });
          globe.onInteract(onInteract);
          if (wide) ctlSlot.appendChild(viewToggle);
          else globe.addCorner(viewToggle);
          if (!ended()) {
            const t = buildForecastToggle();
            if (wide) ctlSlot.appendChild(t);
            else globe.addCorner(t);
          }
          return;
        } catch {
          // WebGL said no; the flat map works everywhere.
          view = "flat";
        }
      }
      const held = renderMapInto(mapSlot, meta, track, {
        units, metric, ghosts, overlays: mapOverlays(), marks: recordMarks(),
        forecast, sizing: "fill", onOverlayClick: openFlight,
        ...(wide ? { legendInto: ctlSlot } : {}),
      });
      if (!held) return;
      map = held;
      held.on("dragstart", onInteract);
      // A spot's tooltip: hovered with a mouse, tapped on a phone.
      held.on("tooltipopen", () => actOnce("Map spot", { view, flight: meta.flight_id }));
      mapSlot.addEventListener("wheel", onInteract, { passive: true });
      held.getContainer().addEventListener("dblclick", onInteract);
      held.zoomControl?.getContainer()?.addEventListener("click", onInteract);
      addWeatherControl(held, {
        ...(wide ? { into: ctlSlot } : { position: "bottomleft" as const }),
        ...weatherOpts,
      });
      if (wide) ctlSlot.appendChild(viewToggle);
      else addCornerControl(held, viewToggle, "bottomleft");
      if (!ended()) {
        const t = buildForecastToggle();
        if (wide) ctlSlot.appendChild(t);
        else addCornerControl(held, t, "bottomleft");
      }
    }

    /** First render: clear the locating state and draw. Safe to call more
     * than once; only the first call does anything. */
    async function drawFirst() {
      if (!firstPaint) return;
      // The globe renderer arrives over the network; if it cannot, the
      // flat map draws instead of nothing.
      if (view === "globe" && !(await ensureGlobeMod())) view = "flat";
      if (!firstPaint) return; // drawn by a parallel caller while awaiting
      firstPaint = false;
      mapSlot.replaceChildren();
      drawMap();
      // The cards were dimmed while their bundled numbers awaited the same
      // first answer as the map.
      root!.classList.remove("fv-loading");
    }

    /** Rebuild the map. `keepView` is forced on for a unit or metric change,
     * where the reader has not asked to move and must not be moved. */
    function drawMapAgain(keepView = userMoved) {
      // Nothing to rebuild yet: the first draw picks up the current units
      // and metric on its own.
      if (firstPaint) return;
      const flatView = keepView && map
        ? { center: map.getCenter(), zoom: map.getZoom() }
        : null;
      const cam = keepView && globe ? globe.getCamera() : null;
      // Leaflet refuses to initialise the same container twice, so the old
      // map has to be disposed rather than merely emptied.
      map?.remove();
      map = null;
      globe?.remove();
      globe = null;
      mapSlot.replaceChildren();
      // The legend and the switches live outside the map, in the top bar,
      // so the teardown has to sweep them too.
      ctlSlot.replaceChildren();
      mapSlot.classList.remove("fv-map-fill");
      drawMap();
      // drawMap assigns map/globe through the closure, which narrowing
      // cannot see past the nulling above; the casts widen them back.
      const m = map as L.Map | null;
      const g = globe as GlobeHandle | null;
      if (flatView && m) {
        m.setView(flatView.center, flatView.zoom, { animate: false });
      }
      if (cam && g) g.setCamera(cam);
    }

    /** The card whose panel is open; the highlight promises details below,
     * so it must not light up for coloring alone. */
    function activeCard(): ActiveCard {
      if (panel === "tracker" || panel === "status" || panel === "records") return panel;
      return panel && isMetricKey(panel) ? panel : null;
    }

    // ---------- records ----------

    /** Every flight's record summary (lib/records.ts): this flight's from
     * its live track, another flight's from its track when that is on the
     * map, else as built. In launch order, which is how ties are kept. */
    function summaries(): FlightSummary[] {
      return flights.flatMap((f) => {
        if (f.flight_id === meta.flight_id) {
          const s = summarize(meta, track, ghosts);
          return s ? [s] : [];
        }
        const o = overlays.find((x) => x.meta.flight_id === f.flight_id)
          ?? recordOverlays.find((x) => x.meta.flight_id === f.flight_id);
        const s = o?.track.length ? summarize(o.meta, o.track, o.ghosts) : null;
        if (s) return [s];
        const built = bundledSummaries.find((x) => x.flight_id === f.flight_id);
        return built ? [built] : [];
      });
    }

    /** What the Records card says, or nothing with fewer than two flights
     * to compare. */
    function recordsInfo() {
      const all = summaries();
      if (all.length < 2) return undefined;
      return { flights: all.length, held: recordsHeldBy(meta.flight_id, recordHolders(all)) };
    }

    /** The pins on the map while the records panel is open: a star where
     * each record was set, the focused one larger and naming its flight. */
    function recordMarks(): MapMark[] {
      if (panel !== "records") return [];
      const holders = recordHolders(summaries());
      return recordPins(holders, units).map((p) => {
        const focus = recordFocus !== null && p.keys.includes(recordFocus);
        const s = holders[p.keys[0]!]!;
        return {
          flight_id: p.flight_id, utc: p.utc, lat: p.lat, lon: p.lon, focus,
          label: focus
            ? `${p.label} · ${s.flight_id} · ${fmtLocalDay(parseUtc(p.utc))}`
            : p.label,
        };
      });
    }

    /** Fly the map to where a record was set. The reader chose this view,
     * so a refresh must not fit it away again. */
    function flyToRecord(key: RecordKey) {
      const s = recordHolders(summaries())[key];
      if (!s) return;
      const at = s.at[key];
      // Beside this flight's line, not a world away from it (lib/basemap.ts).
      const lon = unwrapNear(at.lon, unwrapLons(track).at(-1) ?? at.lon);
      userMoved = true;
      if (map) map.flyTo([at.lat, lon], 5, { duration: 1.2 });
      else globe?.flyTo([lon, at.lat], 4);
      // On a phone the map is above the panel, off screen: bring it up.
      if (window.matchMedia("(max-width: 899px)").matches) {
        mapSlot.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    }

    /** The other flights have arrived for the records panel: put them on
     * the map, unless the panel closed while they were on their way. */
    async function enterRecords() {
      await loadRecordOverlays();
      if (panel === "records") drawMapAgain();
    }

    function leaveRecords() {
      recordFocus = null;
      drawMapAgain(true);
    }

    function paintRecordTiles() {
      for (const b of panelBody.querySelectorAll<HTMLButtonElement>("[data-record]")) {
        b.setAttribute("aria-pressed", String(b.dataset.record === recordFocus));
      }
    }

    function renderSidebar() {
      cardsSlot.innerHTML = sidebarHtml(meta, track, units, activeCard(), {
        ghosts, records: recordsInfo(),
      });
    }

    /** The line under the cards: the newest report, and what kind. */
    function newestText(prefix: string): string {
      const known = lastKnown(track, ghosts);
      if (!known) return "No positions yet";
      return `${prefix} position ${known.utc} UTC${known.coarse ? " (grid square only)" : ""}`;
    }

    function paintCards() {
      const active = activeCard();
      for (const b of cardsSlot.querySelectorAll<HTMLButtonElement>("[data-metric]")) {
        b.setAttribute("aria-pressed", String(b.dataset.metric === active));
      }
      for (const b of cardsSlot.querySelectorAll<HTMLButtonElement>("[data-panel]")) {
        b.setAttribute("aria-pressed", String(b.dataset.panel === active));
      }
    }

    function paintRangeToggle() {
      for (const b of rangeToggle.querySelectorAll<HTMLButtonElement>("[data-range]")) {
        b.setAttribute("aria-pressed", String(b.dataset.range === range));
      }
    }

    // ---------- panel content ----------

    function mini(label: string, value: string): string {
      return `<div class="fv-mini"><span>${label}</span><b>${value}</b></div>`;
    }

    /** The chart drawn in a metric's panel, in the reader's units. Journey
     * charts distance covered, which is the story of the flight in one
     * rising line; the others chart the telemetry itself. */
    function chartSpec(key: MetricKey, pts: TrackPoint[]) {
      const labels = unitLabels(units);
      const t = pts.map((p) => parseUtc(p.utc).getTime());
      const domain: [number, number] = [t[0]!, t[t.length - 1]!];
      const m = METRICS[key];
      if (key === "journey") {
        let cum = 0;
        const values = pts.map((p, i) => {
          if (i > 0) {
            const q = pts[i - 1]!;
            cum += haversineKm(q.lat, q.lon, p.lat, p.lon);
          }
          return { t: t[i]!, v: convert.distance(cum, units) };
        });
        return {
          label: "Distance covered", unit: labels.distance, color: m.color,
          values, domain, decimals: 0,
        };
      }
      const get: Record<string, (p: TrackPoint) => number> = {
        altitude: (p) => convert.altitude(p.altitude_m, units),
        speed: (p) => convert.speed(groundSpeedKt(p), units),
        voltage: (p) => p.voltage_v,
        temperature: (p) => convert.temperature(p.temperature_c, units),
        receivers: (p) => p.rx_station_count,
      };
      const unit: Record<string, string> = {
        altitude: labels.altitude, speed: labels.speed,
        voltage: "V", temperature: labels.temperature, receivers: "stations",
      };
      return {
        label: m.label, unit: unit[key]!, color: m.color,
        values: pts.map((p, i) => ({ t: t[i]!, v: get[key]!(p) })),
        domain, decimals: key === "voltage" ? 2 : 0,
      };
    }

    function metricMinis(key: MetricKey): string {
      const s = trackStats(track)!;
      const volts = track.map((p) => p.voltage_v);
      const temps = track.map((p) => p.temperature_c);
      const alts = track.map((p) => p.altitude_m);
      const speeds = track.map(groundSpeedKt);
      const alt = (m: number) => u.altitude(m, units).text;
      const spd = (kt: number) => u.speed(kt, units).text;
      const tmp = (c: number) => u.temperature(c, units).text;
      if (key === "journey") {
        const prev = track.length >= 2 ? track[track.length - 2]! : null;
        const heading = prev
          ? bearingDeg(prev.lat, prev.lon, s.last.lat, s.last.lon)
          : null;
        const fromLaunchKm = haversineKm(
          track[0]!.lat, track[0]!.lon, s.last.lat, s.last.lon);
        return [
          mini("Distance covered", u.distance(s.distanceKm, units).text),
          mini("From launch", u.distance(fromLaunchKm, units).text),
          mini("Heading", heading === null
            ? "--"
            : `${compassPoint(heading)} · ${Math.round(heading)}°`),
          mini("Time aloft",
            fmtDuration(parseUtc(s.lastUtc).getTime() - parseUtc(s.firstUtc).getTime())),
        ].join("");
      }
      if (key === "altitude") {
        return [
          mini("Now", alt(s.last.altitude_m)),
          mini("Peak", alt(s.maxAltitudeM)),
          mini("Lowest", alt(Math.min(...alts))),
        ].join("");
      }
      if (key === "speed") {
        const avg = speeds.reduce((a, b) => a + b, 0) / speeds.length;
        return [
          mini("Now", speedText(s.last, units)),
          mini("Fastest", spd(s.maxSpeedKt)),
          mini("Average", spd(avg)),
        ].join("");
      }
      if (key === "voltage") {
        return [
          mini("Now", `${s.last.voltage_v.toFixed(2)} V`),
          mini("Lowest", `${Math.min(...volts).toFixed(2)} V`),
          mini("Highest", `${Math.max(...volts).toFixed(2)} V`),
        ].join("");
      }
      if (key === "receivers") {
        const counts = track.map((p) => p.rx_station_count);
        const avg = counts.reduce((a, b) => a + b, 0) / counts.length;
        return [
          mini("Last report", `${s.last.rx_station_count} stations`),
          mini("Most at once", `${Math.max(...counts)}`),
          mini("Average", `${Math.round(avg)}`),
        ].join("");
      }
      return [
        mini("Now", tmp(s.last.temperature_c)),
        mini("Coldest", tmp(Math.min(...temps))),
        mini("Warmest", tmp(Math.max(...temps))),
      ].join("");
    }

    /** Minutes between consecutive reports, stamped on the later one. The
     * 10-minute baseline is the tracker working; the tall spikes are the
     * overnight silences, which is exactly the shape that answers "has it
     * been too quiet?". */
    function statusPanelBody() {
      const gaps: { t: number; v: number }[] = [];
      const pts = filterRange(track, range);
      for (let i = 1; i < pts.length; i++) {
        const t = parseUtc(pts[i]!.utc).getTime();
        gaps.push({ t, v: (t - parseUtc(pts[i - 1]!.utc).getTime()) / 60_000 });
      }
      const s = trackStats(track)!;
      const heard = heardBounds(track, ghosts)!;
      let longest = 0;
      for (let i = 1; i < track.length; i++) {
        longest = Math.max(longest,
          parseUtc(track[i]!.utc).getTime() -
          parseUtc(track[i - 1]!.utc).getTime());
      }
      const sinceMs = Date.now() - parseUtc(heard.lastUtc).getTime();
      // The card only says "Flight ended"; this is where the date goes. A
      // newest report that was a ghost is named too, because every number
      // on the cards is from an older report than the one heard last.
      const lastHeard = (ended()
        ? `${heard.lastUtc.slice(5, 16)} UTC`
        : `${heard.lastUtc.slice(11, 16)} UTC · ${fmtDuration(sinceMs)} ago`) +
        (lastKnown(track, ghosts)?.coarse ? " · position only" : "");
      // A ghost is the tracker heard with only half its report: the
      // Regular message with the grid square, never the telemetry. The
      // map draws them hollow; this is where the count is explained.
      const partial = ghosts.length
        ? mini("Without telemetry", `${fmtInt(ghosts.length)} heard, grid square only`)
        : "";
      panelBody.innerHTML =
        `<div class="fv-minis">${[
          mini("Last heard", lastHeard),
          mini("Reports", `${fmtInt(s.points)} since launch`),
          partial,
          mini("Cadence", "every 10 min in sunlight"),
          mini("Longest silence", `${fmtDuration(longest)} (overnight)`),
        ].join("")}</div>` +
        '<div class="fv-panel-chart"></div>';
      if (gaps.length >= 2) {
        const wide = window.matchMedia("(min-width: 900px)").matches;
        renderChart(panelBody.querySelector<HTMLElement>(".fv-panel-chart")!, {
          label: "Minutes between reports", unit: "min", color: "#5eead4",
          values: gaps, domain: [gaps[0]!.t, gaps[gaps.length - 1]!.t],
          decimals: 0, ...(wide ? { width: 1000 } : {}),
        });
      }
    }

    function renderPanel() {
      if (!panel) return;
      const isMetric = isMetricKey(panel);
      const hasChart = isMetric || panel === "status";
      rangeToggle.hidden = !hasChart || spanMs(track) <= RANGE_MIN_SPAN_MS;
      paintRangeToggle();
      if (isMetric) {
        const key = panel as MetricKey;
        panelTitle.textContent = METRICS[key].label;
        if (!track.length) {
          panelBody.innerHTML = '<p class="empty-note">No decoded telemetry yet.</p>';
          return;
        }
        // Only the speed panel, and only on a flight that has actually
        // outrun its own telemetry: the reader is looking at a number the
        // tracker could not send and deserves to know where it came from.
        const note = key === "speed" && hasSaturatedSpeed(track)
          ? `<p class="fv-panel-note">The tracker cannot encode more than
              ${u.speed(SPEED_CEILING_KT, units).text}. Above that, speed is
              measured from the distance flown either side of each
              report.</p>`
          : "";
        panelBody.innerHTML =
          `<div class="fv-minis">${metricMinis(key)}</div>` + note +
          '<div class="fv-panel-chart"></div>';
        const pts = filterRange(track, range);
        if (pts.length >= 2) {
          // The desktop panel is much wider than it is tall; the default
          // 640x170 box scaled to that width would be a wall of chart. A
          // wider box keeps the height sane and spans the panel edge to
          // edge. The phone panel is narrow, where the default is right.
          const wide = window.matchMedia("(min-width: 900px)").matches;
          renderChart(
            panelBody.querySelector<HTMLElement>(".fv-panel-chart")!,
            { ...chartSpec(key, pts), ...(wide ? { width: 1000 } : {}) },
          );
        }
      } else if (panel === "status") {
        panelTitle.textContent = "Signal";
        if (track.length < 2) {
          panelBody.innerHTML = '<p class="empty-note">Not enough reports yet.</p>';
          return;
        }
        statusPanelBody();
      } else if (panel === "tracker") {
        panelTitle.textContent = `The tracker · ${meta.callsign} ${meta.flight_id}`;
        panelBody.innerHTML = trackerDetailsHtml(meta.tracker);
      } else if (panel === "records") {
        const all = summaries();
        panelTitle.textContent = `Records · ${all.length} flights`;
        panelBody.innerHTML = recordsHtml({
          summaries: all, holders: recordHolders(all), current: meta.flight_id,
          units, focus: recordFocus, hrefFor: flightHref,
        });
      } else if (panel === "data") {
        panelTitle.textContent = "Telemetry data";
        panelBody.innerHTML =
          `<p class="fv-panel-note">Every report the tracker has sent, newest
            first. <button class="linklike" id="download" type="button">Download
            the full track as JSON</button>.</p>` +
          tableHtml(track);
        const details = panelBody.querySelector("details");
        if (details) details.open = true;
      } else {
        panelTitle.textContent = "About";
        // Traquito's own dashboard for this flight, from launch day to
        // tomorrow, so the link is never stale.
        const day = (d: Date) => d.toISOString().slice(0, 10);
        const since = meta.launch_utc
          ? meta.launch_utc.slice(0, 10)
          : day(new Date(Date.now() - 30 * 86_400_000));
        const until = day(new Date(Date.now() + 86_400_000));
        const traquito = "https://traquito.github.io/search/spots/dashboard/?band="
          + `${encodeURIComponent(meta.band)}&channel=${meta.channel}`
          + `&callsign=${encodeURIComponent(meta.callsign)}&dtGte=${since}&dtLte=${until}`;
        panelBody.innerHTML = `<div class="fv-about prose">
          <p>Pico ballooning is amateur radio's smallest space program: a
          gram-scale solar tracker under a party-sized superpressure
          balloon, released into the jet stream and never recovered. The
          envelope settles at one altitude instead of bursting, so a good
          flight lasts weeks and the great chase is a full lap of the
          globe. This site follows the flights of ${escText(site.callsign)}.</p>
          <p>The tracker whispers 20 milliwatts of WSPR; volunteer stations
          around the world hear it and upload every decode to
          <a href="https://wspr.live/">wspr.live</a>, and this page queries
          that database and decodes the telemetry right in your browser —
          no server of ours in the loop. It checks for new reports every
          couple of minutes.</p>
          <p class="fv-about-links">
            <a href="${escAttr(site.repo)}">Source &amp; data</a>
            <a href="https://wspr.live/">Spots: wspr.live</a>
            <a href="https://traquito.github.io/">Trackers: Traquito</a>
            <a href="${escAttr(traquito)}">Traquito dashboard</a>
            <a href="${escAttr(site.upstream)}#fly-your-own">Make one for your callsign</a>
          </p>
        </div>`;
      }
    }

    function escText(s: string): string {
      return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    }
    function escAttr(s: string): string {
      return escText(s).replace(/"/g, "&quot;");
    }

    /** Put a panel on screen. Separate from `openPanel` because opening one
     * from a link must not scroll the page out from under the reader before
     * they have seen it, nor rewrite the URL that just asked for it. */
    function showPanel(kind: PanelKind) {
      const wasRecords = panel === "records";
      panel = kind;
      renderPanel();
      paintCards();
      panelEl.hidden = false;
      root!.classList.add("panel-open");
      // The records panel brings the other flights onto the map and takes
      // them away again; a panel opened over it takes them away too.
      if (kind === "records" && !wasRecords) void enterRecords();
      else if (wasRecords && kind !== "records") leaveRecords();
    }

    function openPanel(kind: PanelKind) {
      act("Panel", { panel: kind, flight: meta.flight_id });
      showPanel(kind);
      pinInUrl(urlWithPanel(location.href, kind));
      // On a phone the panel is below the cards, off screen: bring it up.
      if (window.matchMedia("(max-width: 899px)").matches) {
        panelEl.scrollIntoView({ behavior: "smooth", block: "nearest" });
      }
    }

    function closePanel() {
      const wasRecords = panel === "records";
      panel = null;
      panelEl.hidden = true;
      root!.classList.remove("panel-open");
      paintCards();
      if (wasRecords) leaveRecords();
      // Nothing open is the page's own default, so the parameter comes back
      // out rather than being set to a value meaning "none".
      pinInUrl(urlWithPanel(location.href, null));
    }

    // ---------- wiring ----------

    /** Put a choice in the address bar, so copying the URL shares what is on
     * screen. replaceState, not pushState: flipping a toggle is not a
     * navigation, and a back button that walks through them rather than
     * leaving the page is worse than useless.
     *
     * Only ever called from a toggle. Doing it on load would stamp a
     * parameter onto a URL the reader never asked to change. */
    function pinInUrl(href: string) {
      try {
        history.replaceState(history.state, "", href);
      } catch {
        /* a sandboxed or file:// page refuses this; the view still changes */
      }
      // The next flight should open with the same toggles.
      paintNextLink();
    }

    function paintUnitToggle() {
      for (const b of root!.querySelectorAll<HTMLButtonElement>("[data-units]")) {
        b.setAttribute("aria-pressed", String(b.dataset.units === units));
      }
    }

    paintUnitToggle();
    paintNextLink();
    // The build-time sidebar is metric, and its cards show none active; if
    // the reader's units differ, or a link opened a panel, or the page was
    // built around another flight, it has to be redrawn before they read it.
    if (swapped || units !== "metric" || panel) renderSidebar();
    // A `?p=` link opens its panel now, on the bundled track, rather than
    // waiting on wspr.live; the first refresh re-renders it either way.
    if (panel) showPanel(panel);

    // Reading a chart's values: once per panel per page, since the hover
    // fires on every pixel the pointer crosses.
    panelBody.addEventListener("pointermove", (ev) => {
      if (panel && (ev.target as HTMLElement).closest(".fv-panel-chart")) {
        actOnce("Chart read", { panel, flight: meta.flight_id }, `chart:${panel}`);
      }
    }, { passive: true });

    nextLink.addEventListener("click", () => {
      const i = flights.findIndex((f) => f.flight_id === meta.flight_id);
      act("Switch flight", { via: "next", to: flights[(i + 1) % flights.length]!.flight_id });
    });

    // Cards re-render on refresh, so listen on the slot, not the buttons.
    cardsSlot.addEventListener("click", (ev) => {
      const panelBtn = (ev.target as HTMLElement)
        .closest<HTMLButtonElement>("[data-panel]");
      if (panelBtn) {
        const kind = panelBtn.dataset.panel as PanelKind;
        if (panel === kind) closePanel();
        else openPanel(kind);
        return;
      }
      const btn = (ev.target as HTMLElement)
        .closest<HTMLButtonElement>("[data-metric]");
      if (!btn || !isMetricKey(btn.dataset.metric)) return;
      const key = btn.dataset.metric;
      if (key === metric && panel === key) {
        // Pressing the active card again puts the panel away; the coloring
        // stays, because they chose it.
        closePanel();
        return;
      }
      if (key !== metric) {
        metric = key;
        // Recoloring is a redraw; the reader asked for new colors, not a
        // new view, so the camera holds still. The globe has no metric
        // colors, so it is left alone; switching back picks up the choice.
        if (view === "flat") drawMapAgain(true);
      }
      openPanel(key);
    });

    for (const b of root.querySelectorAll<HTMLButtonElement>("[data-panel]")) {
      b.addEventListener("click", () => {
        const kind = b.dataset.panel as PanelKind;
        if (panel === kind) closePanel();
        else openPanel(kind);
      });
    }
    root.querySelector("#panel-close")!.addEventListener("click", closePanel);

    for (const b of rangeToggle.querySelectorAll<HTMLButtonElement>("[data-range]")) {
      b.addEventListener("click", () => {
        const next = b.dataset.range as Range;
        if (next === range) return;
        act("Range", { range: next, panel });
        range = next;
        renderPanel();
      });
    }

    for (const b of root.querySelectorAll<HTMLButtonElement>("[data-units]")) {
      b.addEventListener("click", () => {
        const next = b.dataset.units as Units;
        if (next === units) return;
        act("Units", { to: next });
        units = next;
        saveUnits(units);
        pinInUrl(urlWithUnits(location.href, units));
        paintUnitToggle();
        // The map's legend and tooltips carry units too, so it is redrawn
        // as well -- holding the reader's exact view, since they asked to
        // change units, not to move. The globe shows no numbers at all.
        if (view === "flat") drawMapAgain(true);
        renderSidebar();
        renderPanel();
      });
    }

    // A record tile: the map flies to where it was set, and the tile stays
    // lit until it is pressed again or the panel goes.
    panelBody.addEventListener("click", (ev) => {
      const btn = (ev.target as HTMLElement).closest<HTMLButtonElement>("[data-record]");
      if (!btn || panel !== "records" || !isRecordKey(btn.dataset.record)) return;
      const key = btn.dataset.record;
      recordFocus = recordFocus === key ? null : key;
      if (recordFocus) act("Record", { record: key, flight: meta.flight_id });
      paintRecordTiles();
      drawMapAgain(true);
      if (recordFocus) flyToRecord(key);
    });

    // The download button lives inside the re-rendered data panel.
    panelBody.addEventListener("click", (ev) => {
      if (!(ev.target as HTMLElement).closest("#download")) return;
      act("Download", { flight: meta.flight_id });
      const blob = new Blob([JSON.stringify({ ...meta, track, ghosts }, null, 1)],
        { type: "application/json" });
      const a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = `${meta.flight_id}.json`;
      a.click();
      URL.revokeObjectURL(a.href);
    });

    // One check in flight at a time: the timer and a tab waking up can
    // both ask in the same moment.
    let updating = false;
    async function update() {
      if (ended()) {
        // Nothing to ask about this flight: the committed track is the
        // whole of it. A live flight overlaid on it still moves.
        const overlayAdded = await refreshOverlays();
        if (firstPaint) {
          await drawFirst();
          renderSidebar();
          renderPanel();
        } else if (overlayAdded > 0) {
          drawMapAgain();
        }
        updatedEl.textContent = lastKnown(track, ghosts)
          ? newestText("Flight ended · last")
          : "No positions recorded";
        return;
      }
      if (updating) return;
      updating = true;
      const [result, overlayAdded] = await Promise.all([
        refreshTrack(meta, track, ghosts), refreshOverlays(),
      ]).finally(() => { updating = false; });
      if (result.error) {
        // The bundled track is all there is; show it rather than a spinner
        // that will never resolve.
        void drawFirst();
        const known = lastKnown(track, ghosts);
        updatedEl.textContent = known
          ? `Can't reach wspr.live — showing up to ${known.utc} UTC`
          : "Can't reach wspr.live";
        return;
      }
      track = result.track;
      ghosts = result.ghosts;
      // The forecast rides on the newest report, so it is brought up to
      // date now; but the map does not wait long for SondeHub, and a slow
      // answer redraws when it lands.
      const fc = syncForecast();
      const fcChanged = await Promise.race([
        fc, new Promise<null>((r) => setTimeout(() => r(null), FORECAST_WAIT_MS)),
      ]);
      if (fcChanged === null) {
        void fc.then((changed) => { if (changed && !firstPaint) drawMapAgain(); });
      }
      if (firstPaint) {
        await drawFirst();
        renderSidebar();
        renderPanel();
      } else if (result.added > 0 || overlayAdded > 0 || fcChanged) {
        drawMapAgain();
        renderSidebar();
        renderPanel();
      }
      updatedEl.textContent = lastKnown(track, ghosts)
        ? newestText("Newest")
        : "No positions yet";
    }

    // The sidebar scrolls without a scrollbar, so a chevron says when the
    // footer is below the fold. Watched by size, not by render: the cards
    // re-render often and the viewport can change under them.
    function paintSideMore() {
      sideMore.hidden = sideEl.scrollHeight - sideEl.clientHeight - sideEl.scrollTop < 8;
    }
    sideEl.addEventListener("scroll", paintSideMore, { passive: true });
    const sideWatch = new ResizeObserver(paintSideMore);
    sideWatch.observe(sideEl);
    sideWatch.observe(cardsSlot);
    sideMore.querySelector("button")!.addEventListener("click", () => {
      sideEl.scrollTo({ top: sideEl.scrollHeight, behavior: "smooth" });
    });

    overlayBtn.addEventListener("click", async () => {
      // Either every other flight is on the map or none is; a link can
      // name particular ones, the button does not need to.
      overlayChoice = overlays.length ? null : "all";
      act("Overlay", { to: overlayChoice ? "on" : "off", flight: meta.flight_id });
      pinInUrl(urlWithOverlays(location.href, overlayChoice));
      await loadOverlays();
      // Adding a flight is a reason to see it: the view refits unless the
      // reader has already taken hold of the map.
      drawMapAgain();
    });

    // The overlays' committed tracks come first, so the opening draw has
    // them; the timer then runs whatever the flight's own state, because
    // a closed flight can carry a live one on its map.
    await loadOverlays();
    // A `?p=records` arrival wants the other flights on the opening draw.
    if (panel === "records") await loadRecordOverlays();
    update();
    // If wspr.live hangs rather than failing, the bundled track appears
    // anyway; a late answer then lands through the normal refresh path.
    setTimeout(() => void drawFirst(), 6000);
    setInterval(update, REFRESH_MS);
    // A phone that has been asleep should catch up the moment it is looked at.
    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "visible") update();
    });
  }
</script>
