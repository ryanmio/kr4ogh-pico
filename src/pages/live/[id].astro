---
/** A flight at its own URL. Same view as the home page, by the same
 * component; the home page shows the featured flight, this is the
 * permalink for a particular one, closed flights included. */
import FlightLive from "../../components/FlightLive.astro";
import Base from "../../layouts/Base.astro";
import { ghostsFor, shownFlights, trackFor } from "../../lib/flights";
import type { FlightMeta, GhostPoint, TrackPoint } from "../../lib/types";

export async function getStaticPaths() {
  return shownFlights().map((flight) => ({
    params: { id: flight.flight_id },
    props: { flight, track: trackFor(flight), ghosts: ghostsFor(flight) },
  }));
}

const { flight, track, ghosts } = Astro.props as {
  flight: FlightMeta; track: TrackPoint[]; ghosts: GhostPoint[];
};
const what = flight.status === "closed" ? "balloon flight" : "live balloon telemetry";
---

<Base
  title={`${flight.callsign} ${flight.flight_id} — ${what}`}
  description={`Telemetry for ${flight.callsign} flight ${flight.flight_id}.`}
  chrome={false}
>
  <FlightLive flight={flight} track={track} ghosts={ghosts} flights={shownFlights()} mode="permalink" />
</Base>
