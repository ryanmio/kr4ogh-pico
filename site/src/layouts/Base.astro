---
import { withBase } from "../lib/base";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** false gives the page the whole viewport: no site header or footer.
   * The live flight view brings its own chrome, floated over the map. */
  chrome?: boolean;
}

const {
  title,
  description = "KR4OGH pico balloon flights: live WSPR telemetry and archived tracks.",
  chrome = true,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <title>{title}</title>

    <!-- Share cards. Title and description carry them for now; X falls back
         to these when no twitter:* tags exist. No og:url and no canonical
         until SITE_URL is set in the deploy -- `site` defaults to localhost,
         and a localhost canonical is worse than none. Same blocker as
         og:image, which has to be absolute. -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    {chrome && (
      <header class="site-header">
        <div class="container">
          <a class="site-title" href={withBase("/")}
            >KR4OGH<span class="tld">.balloon</span></a
          >
        </div>
      </header>
    )}
    {chrome
      ? <main><div class="container"><slot /></div></main>
      : <main class="bare"><slot /></main>}
    {chrome && (
      <footer class="site-footer">
        <div class="container">
          <span>KR4OGH pico balloon program</span>
          <a href="https://github.com/ryanmio/kr4ogh-pico">Source &amp; data</a>
          <a href="https://wspr.live/">Spots: wspr.live</a>
          <a href="https://traquito.github.io/">Trackers: Traquito</a>
        </div>
      </footer>
    )}
  </body>
</html>
