---
import Base from "../../layouts/Base.astro";
---

<Base
  title="Live flight — KR4OGH"
  description="Live pico balloon telemetry from the Supabase cache."
>
  <div id="live-root">
    <p class="loading">Loading from the live cache…</p>
  </div>
</Base>

<script>
  import { withBase } from "../../lib/base";
  import { renderFlightView } from "../../lib/flightview";
  import { esc } from "../../lib/render";
  import { cacheConfigured, fetchFlights, fetchTrack } from "../../lib/supabase";
  import type { FlightMeta, TrackPoint } from "../../lib/types";

  const root = document.getElementById("live-root")!;
  const flightId = new URLSearchParams(location.search).get("flight");
  const REFRESH_MS = 5 * 60 * 1000;

  function note(html: string) {
    root.innerHTML = `<div class="notice">${html}</div>
      <p class="toolbar"><a class="button" href="${withBase("/")}">Back to flights</a></p>`;
  }

  function header(meta: FlightMeta, updated: Date): string {
    const live = meta.status === "live";
    return `<div class="flight-title-row">
        <h1>${esc(meta.flight_id)} · ${esc(meta.callsign)}</h1>
        <span class="badge ${live ? "badge-live" : "badge-closed"}">
          ${live ? "live" : "closed"}</span>
      </div>
      <p class="flight-subtitle">${esc(meta.band)} · channel ${meta.channel}
        ${meta.launch_utc ? ` · launched ${esc(meta.launch_utc.slice(0, 10))} UTC` : ""}
        ${meta.close_reason ? ` · ${esc(meta.close_reason)}` : ""}</p>
      <div id="fv"></div>
      <div class="toolbar">
        <button class="button" id="refresh">Refresh</button>
        <button class="button" id="download">Download JSON</button>
        <span class="updated">updated ${updated.toISOString().slice(11, 19)} UTC,
          every 5 min. Gaps are normal: the tracker runs on solar.</span>
      </div>`;
  }

  let track: TrackPoint[] = [];
  let meta: FlightMeta | undefined;

  async function load() {
    if (!cacheConfigured()) {
      note("No live cache configured for this build.");
      return;
    }
    if (!flightId) {
      note(`No flight selected. Pick one from the
        <a href="${withBase("/")}">flights page</a>.`);
      return;
    }
    try {
      const flights = await fetchFlights();
      meta = flights.find((f) => f.flight_id === flightId);
      if (!meta) {
        note(`No flight called <code>${esc(flightId)}</code> in the live cache.
          It may have closed and moved to the
          <a href="${withBase("/")}">archive</a>.`);
        return;
      }
      track = await fetchTrack(flightId);
    } catch {
      note(`Live cache unreachable, probably paused between flights. The
        <a href="${withBase("/")}">archive</a> still works.`);
      return;
    }

    document.title = `${meta.flight_id} live — KR4OGH`;
    root.innerHTML = header(meta, new Date());
    renderFlightView(
      document.getElementById("fv")!, meta, track, meta.status === "live",
    );
    document.getElementById("refresh")!.addEventListener("click", load);
    document.getElementById("download")!.addEventListener("click", () => {
      const blob = new Blob(
        [JSON.stringify({ ...meta, track }, null, 1)],
        { type: "application/json" },
      );
      const a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = `${meta!.flight_id}.json`;
      a.click();
      URL.revokeObjectURL(a.href);
    });
  }

  load();
  setInterval(load, REFRESH_MS);
</script>
