---
import Base from "../layouts/Base.astro";
import { archivedFlights } from "../lib/archive";
import { withBase } from "../lib/base";
import { liveFlights, trackFor } from "../lib/flights";
import { fmtInt } from "../lib/format";
import { flightCardHtml, outcomeBadgeClass } from "../lib/render";

const archives = await archivedFlights();
const archiveCards = archives.map(({ entry, archive }) =>
  flightCardHtml({
    href: withBase(`/flights/${archive.flight_id}/`),
    title: entry.data.title,
    badge: entry.data.outcome,
    badgeClass: outcomeBadgeClass(entry.data.outcome),
    meta: `${archive.band} · ch ${archive.channel} · ` +
      `${fmtInt(archive.track.length)} records · ${entry.data.period}`,
    summary: entry.data.summary,
  }),
);

// Live cards are built from the committed track, so the card carries a real
// position before any script runs. The script then refreshes them in place
// from wspr.live.
const live = liveFlights().map((flight) => ({ flight, track: trackFor(flight.flight_id) }));
const liveCards = live.map(({ flight, track }) => {
  const last = track.at(-1);
  return flightCardHtml({
    href: withBase(`/live/${flight.flight_id}/`),
    title: `${flight.flight_id} · ${flight.callsign}`,
    badge: "live",
    badgeClass: "badge-live",
    meta: `${flight.band} · ch ${flight.channel}` +
      (flight.launch_utc ? ` · launched ${flight.launch_utc.slice(0, 10)}` : ""),
    summary: last
      ? `Last heard ${last.utc} UTC from ${last.grid6} at ` +
        `${fmtInt(last.altitude_m)} m, ${last.voltage_v.toFixed(2)} V.`
      : "No decoded telemetry yet.",
  });
});
---

<Base title="KR4OGH pico balloon flights">
  <section class="hero">
    <h1><span class="callsign">KR4OGH</span> pico balloon flights</h1>
    <p>
      Solar-powered trackers on 20&nbsp;m, reporting position, altitude and
      battery voltage over
      <a href="https://en.wikipedia.org/wiki/WSPR_(amateur_radio_software)">WSPR</a>
      at a few tens of milliwatts. Volunteer receiving stations hear them and
      report the spots; this site decodes and maps them. See
      <a href={withBase("/about/")}>about</a> for how it works.
    </p>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>In the air</h2>
    </div>
    {live.length > 0
      ? <div
          class="flight-grid"
          id="live-flights"
          data-flights={JSON.stringify(live)}
          set:html={liveCards.join("")}
        />
      : <div class="notice notice-accent">Nothing in the air right now.</div>}
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Archive</h2>
    </div>
    {archives.length > 0
      ? <div class="flight-grid" set:html={archiveCards.join("")} />
      : <p class="empty-note">No archived flights yet.</p>}
  </section>
</Base>

<script>
  import { fmtInt, fmtRelative } from "../lib/format";
  import { refreshTrack } from "../lib/livetrack";
  import type { FlightMeta, TrackPoint } from "../lib/types";

  const grid = document.getElementById("live-flights");
  if (grid) {
    const entries = JSON.parse(grid.dataset.flights!) as
      { flight: FlightMeta; track: TrackPoint[] }[];
    const cards = [...grid.querySelectorAll<HTMLElement>(".flight-card")];

    async function refresh() {
      await Promise.all(entries.map(async ({ flight, track }, i) => {
        const summary = cards[i]?.querySelector(".flight-card-summary");
        if (!summary) return;
        const result = await refreshTrack(flight, track);
        const last = result.track.at(-1);
        // On failure refreshTrack returns the bundled track untouched, so the
        // card degrades to the last known position rather than to an error.
        summary.textContent = last
          ? `Last heard ${fmtRelative(last.utc)} from ${last.grid6} at `
            + `${fmtInt(last.altitude_m)} m, ${last.voltage_v.toFixed(2)} V.`
          : "No decoded telemetry yet.";
      }));
    }

    refresh();
    setInterval(refresh, 2 * 60 * 1000);
  }
</script>
