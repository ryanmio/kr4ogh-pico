# Live-flight reads. Both PUBLIC_: they are compiled into the client bundle,
# which is safe — this is the anon (or publishable) key, and RLS grants anon
# SELECT only. Never put the service role key anywhere near the site.
#
# Leave unset to build a fully static site: archived flights render from git
# regardless, and the live section says the cache is not configured.
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
